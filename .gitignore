# ---- 构建产物（含签名私钥，严禁提交）----
build/
*.jks
*.keystore
*.apk.idsig
dist/
# 发布暂存目录含 APK 二进制副本，产物一律走 GitHub Release，不入库
release/
windows/build/

# ---- 爬取/复现时的工作目录 ----
tools/mirror/
tools/work/
tools/__pycache__/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Dart 工具缓存（pubspec.lock 需提交以锁定依赖）----
.dart_tool/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- 本地配置（凭证一律走环境变量）----
.env
local.properties

# ---- Dart 遗留本地路径文件（由 .dart_tool/package_config.json 取代）----
.packages
